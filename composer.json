{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jayi/polycart",
    "description": "Typed, flexible carts for Laravel: shopping carts, quotes, orders and projects in one model",
    "keywords": [
        "laravel",
        "jayi",
        "polycart"
    ],
    "homepage": "https://github.com/jayi/polycart",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "laravel/mcp": "^1.0"
    },
    "require-dev": {
        "jayi/atrium": "dev-main",
        "jayi/cortex": "dev-main",
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "jayi/atrium": "Browse and manage carts from the Atrium dashboard (dev-main).",
        "jayi/cortex": "Let Cortex agents use the cart tools and manage the MCP instructions and tool descriptions (dev-main)."
    },
    "autoload": {
        "psr-4": {
            "JayI\\Polycart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JayI\\Polycart\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JayI\\Polycart\\PolycartServiceProvider"
            ],
            "aliases": {
                "Polycart": "JayI\\Polycart\\Facades\\Polycart"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jayjfletcher/Atrium.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jayjfletcher/cortex.git"
        }
    ]
}
